# build output
dist/

# generated types
.astro/

# vault-synced content (generated by `npm run sync:content`; the Obsidian vault is the
# source of truth — see README ▸ Editing content). The .gitkeep files keep the collection
# directories present so a fresh clone still builds.
src/content/projects/*
!src/content/projects/.gitkeep
src/content/journal/*
!src/content/journal/.gitkeep

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# raw design exports (44 MB uncompressed raster — sources stay local)
*.ppm

# local chat exports
chat-export-*.json

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/


# python bytecode (deployment tests)
__pycache__/
