---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import {
  dir,
  htmlLang,
  languages,
  normalizePath,
  switchLangPath,
  t,
  useTranslations,
  type Lang,
} from '../i18n/translations';

interface Props {
  lang: Lang;
  /** Writing direction. Defaults to the direction of `lang` (LTR for en, RTL for fa). */
  dir?: 'ltr' | 'rtl';
  title: string;
  description: string;
  /** Social share image path or absolute URL (add `public/og.png`, 1200x630). */
  image?: string;
  /** Extra schema.org nodes for this page (without `@context`). */
  jsonLd?: Record<string, unknown>[];
}

const {
  lang,
  dir: direction = dir[lang],
  title,
  description,
  image = '/og.png',
  jsonLd = [],
} = Astro.props;
const d = useTranslations(lang);

const path = normalizePath(Astro.url.pathname);
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);

const alternates = languages.map((code) => ({
  code,
  href: new URL(switchLangPath(path, code), Astro.site).href,
}));
const defaultHref = new URL(switchLangPath(path, 'en'), Astro.site).href;

const sameAs = d.contact.methods.flatMap((method) =>
  method.href && !method.href.startsWith('mailto:') ? [method.href] : [],
);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.name,
    alternateName: site.alternateName,
    jobTitle: d.site.jobTitle,
    description: d.site.bio,
    url: site.url,
    email: `mailto:${site.email}`,
    sameAs,
  },
  ...jsonLd,
];

const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={htmlLang[lang]} dir={direction} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#09090b" />

    <!-- Language alternates -->
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    {
      languages
        .filter((code) => code !== lang)
        .map((code) => (
          <meta property="og:locale:alternate" content={code === 'fa' ? 'fa_IR' : 'en_US'} />
        ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!--
      Theme bootstrap. The root element ships with `class="dark"` so the default
      theme needs no JS at all; this only switches to light when stored, and wires
      the toggle button through one delegated listener (no extra JS bundle).
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var KEY = 'theme';

        function read() {
          try {
            return localStorage.getItem(KEY);
          } catch (error) {
            return null;
          }
        }

        function apply(theme) {
          var dark = theme !== 'light';
          root.classList.toggle('dark', dark);
          root.setAttribute('data-theme', dark ? 'dark' : 'light');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#09090b' : '#ffffff');
        }

        apply(read() === 'light' ? 'light' : 'dark');

        document.addEventListener('click', function (event) {
          var target = event.target;
          var trigger = target && target.closest ? target.closest('[data-theme-toggle]') : null;
          if (!trigger) return;

          var next = root.classList.contains('dark') ? 'light' : 'dark';
          try {
            localStorage.setItem(KEY, next);
          } catch (error) {
            /* Storage unavailable — the theme still applies for this page view. */
          }
          apply(next);
        });
      })();
    </script>
  </head>

  <body id="top" class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:rounded focus:border focus:border-line focus:bg-surface focus:px-3 focus:py-2 focus:text-primary"
    >
      {t('a11y.skip', lang)}
    </a>

    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
