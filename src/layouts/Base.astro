---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { dir, languages, locale, type Lang } from '../lib/i18n';
import { abs, personNode, websiteNode, type PageSeo } from '../lib/seo';
import { t } from '../i18n/translations';

interface Props { seo: PageSeo; navKey?: string; chrome?: boolean }
const { seo, navKey = '', chrome = true } = Astro.props;
const lang: Lang = seo.lang;
const canonical = abs(seo.canonical ?? seo.path);
const image = abs(seo.image ?? '/og.png');
const alternates = seo.alternates ?? {};
const hreflangs = languages.filter((l) => alternates[l]);
const xdefault = alternates.en ?? alternates[lang];
const graph = [personNode(lang), websiteNode, ...(seo.graph ?? [])];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang={lang} dir={dir[lang]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords?.length ? <meta name="keywords" content={seo.keywords.join(', ')} /> : null}
    <meta name="author" content={site.name} />
    <meta name="robots" content={seo.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#07090f" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} (${lang})`} href={`/${lang}/rss.xml`} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {hreflangs.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l]!)} />)}
    {xdefault ? <link rel="alternate" hreflang="x-default" href={abs(seo.path === '/' ? '/' : xdefault)} /> : null}

    <meta property="og:type" content={seo.type ?? 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {seo.imageAlt ? <meta property="og:image:alt" content={seo.imageAlt} /> : null}
    <meta property="og:locale" content={locale[lang]} />
    {languages.filter((l) => l !== lang && alternates[l]).map((l) => <meta property="og:locale:alternate" content={locale[l]} />)}
    {seo.published ? <meta property="article:published_time" content={seo.published.toISOString()} /> : null}
    {seo.updated ? <meta property="article:modified_time" content={seo.updated.toISOString()} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={ld} />
    <script is:inline>
      (function () {
        var r = document.documentElement, K = 'theme';
        function apply(m) { r.classList.toggle('dark', m !== 'light'); var c = document.querySelector('meta[name=theme-color]'); if (c) c.content = m === 'light' ? '#f5fbef' : '#07090f'; }
        try { apply(localStorage.getItem(K)); } catch (e) {}
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-theme-toggle]'); if (!b) return;
          var n = r.classList.contains('dark') ? 'light' : 'dark';
          try { localStorage.setItem(K, n); } catch (e2) {} apply(n);
        });
        if (navigator.doNotTrack !== '1' && !/^\/admin/.test(location.pathname)) {
          try { navigator.sendBeacon('/api/v', JSON.stringify({ p: location.pathname, r: document.referrer.slice(0, 200) })); } catch (e) {}
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:rounded focus:border focus:border-line focus:bg-surface focus:px-3 focus:py-2">{t('a11y.skip', lang)}</a>
    {chrome && <Header lang={lang} navKey={navKey} alternates={alternates} path={seo.path} />}
    <slot />
    {chrome && <Footer lang={lang} />}
  </body>
</html>
