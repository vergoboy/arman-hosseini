---
import { Moon, Sun } from '@lucide/astro';
import { t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const label = t('theme.toggle', lang);
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted transition-colors duration-300 hover:border-accent hover:text-accent"
>
  <!-- Dark active -> show the sun (switch to light). -->
  <Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
  <Moon class="block h-4 w-4 dark:hidden" aria-hidden="true" />
</button>
