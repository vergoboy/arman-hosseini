---
import BrandIcon from './BrandIcon.astro';
import { socials } from '../data/socials';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 px-6 md:px-12 lg:px-24 py-12">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <p class="font-mono text-sm text-zinc-400">
          <span class="text-orange-600">$</span> echo $USER
        </p>
        <p class="mt-1 text-zinc-100 font-medium">Arman Hosseini</p>
        <p class="text-sm text-zinc-400 mt-1">
          Software Engineer — Rust, Linux & Networks
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith('#') ? undefined : '_blank'}
            rel={s.href.startsWith('#') ? undefined : 'noopener noreferrer'}
            class="inline-flex items-center gap-2 text-sm text-zinc-400 transition-colors duration-300 hover:text-orange-600"
            aria-label={s.label}
          >
            <BrandIcon name={s.icon} class="w-4 h-4" />
            <span class="hidden sm:inline">{s.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-mono text-xs text-zinc-400">
        © {year} Arman Hosseini. All rights reserved.
      </p>
      <p class="font-mono text-xs text-zinc-400">
        Built with Astro & Tailwind CSS
      </p>
    </div>
  </div>
</footer>

