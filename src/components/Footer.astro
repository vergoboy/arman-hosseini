---
import BrandIcon from './BrandIcon.astro';
import Mark from './Mark.astro';
import { Rss } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { U } from '../lib/ui';
import type { Lang } from '../lib/i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const d = useTranslations(lang);
---
<footer class="mt-24 border-t border-line bg-surface/60">
  <div class="wrap grid gap-8 py-10 sm:grid-cols-[1fr_auto]">
    <div>
      <div class="flex items-center gap-3"><Mark size={36} alt="" /><p class="font-semibold">{lang === 'fa' ? site.alternateName : site.name}</p></div>
      <p class="mt-3 max-w-md text-sm text-muted">{d.site.bio}</p>
      <p class="mt-4 font-mono text-xs text-muted" dir="ltr">© {new Date().getFullYear()} {site.name} · {U(lang).lowData}</p>
    </div>
    <ul class="flex flex-wrap items-start gap-2 sm:max-w-xs sm:justify-end" aria-label={d.footer.command}>
      {d.contact.methods.map((m) => (
        m.href ? <li><a class="btn !px-3 !py-2" href={m.href} rel="me noopener" aria-label={m.label}><BrandIcon name={m.icon} class="h-4 w-4" /><span class="sr-only sm:not-sr-only">{m.label}</span></a></li> : null
      ))}
      <li><a class="btn !px-3 !py-2" href={`/${lang}/rss.xml`}><Rss class="h-4 w-4" aria-hidden="true" />RSS</a></li>
    </ul>
  </div>
</footer>
