---
import {
  localizedPath,
  navRoutes,
  normalizePath,
  t,
  useTranslations,
  type Lang,
} from '../i18n/translations';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
const path = normalizePath(Astro.url.pathname);

const homeHref = localizedPath(lang, '');

const links = (Object.keys(navRoutes) as (keyof typeof navRoutes)[]).map((key) => ({
  key,
  href: localizedPath(lang, navRoutes[key]),
  label: d.nav[key],
}));

const isActive = (href: string) => (href === homeHref ? path === homeHref : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-page/80 backdrop-blur">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-6 py-4"
  >
    <Logo lang={lang} />

    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <nav aria-label={t('nav.label', lang)}>
        <ul class="flex items-center gap-4 sm:gap-6">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'font-mono text-sm transition-colors duration-300 hover:text-accent',
                    isActive(link.href) ? 'text-accent' : 'text-muted',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle lang={lang} />
        <LangSwitcher lang={lang} />
      </div>
    </div>
  </div>
</header>
