---
import { Sun, Languages } from '@lucide/astro';
import Mark from './Mark.astro';
import { lp, languages, type Lang } from '../lib/i18n';
import { t, navRoutes } from '../i18n/translations';
import { site } from '../data/site';

interface Props { lang: Lang; navKey?: string; alternates?: Partial<Record<Lang, string>>; path: string }
const { lang, navKey = '', alternates = {}, path } = Astro.props;
const other = languages.find((l) => l !== lang)!;
const rest = path.replace(/^\/(en|fa)(?=\/|$)/, '') || '/';
const switchHref = alternates[other] ?? lp(other, rest === '/' ? '' : rest);
const items = (['about', 'projects', 'journal', 'contact'] as const).map((k) => ({
  k, href: lp(lang, navRoutes[k]), label: t(`nav.${k}`, lang),
}));
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-page/80 backdrop-blur-md">
  <div class="wrap flex items-center gap-3 py-2.5">
    <a href={lp(lang)} class="flex items-center gap-2.5 font-semibold" aria-label={site.name}>
      <Mark size={30} alt="" />
      <span class="hidden sm:inline">{lang === 'fa' ? site.alternateName : site.name}</span>
    </a>
    <nav aria-label={t('nav.label', lang)} class="ms-auto flex min-w-0 items-center gap-1 overflow-x-auto text-sm">
      {items.map((i) => (
        <a href={i.href} aria-current={navKey === i.k ? 'page' : undefined}
           class:list={['whitespace-nowrap rounded-md px-3 py-1.5 text-muted hover:text-primary', navKey === i.k && '!text-accent bg-raised']}>
          {i.label}
        </a>
      ))}
    </nav>
    <a href={switchHref} hreflang={other} lang={other} class="btn !px-2.5 !py-1.5 font-mono text-xs" aria-label={t('lang.label', lang)}>
      <Languages class="h-4 w-4" aria-hidden="true" />{other.toUpperCase()}
    </a>
    <button type="button" data-theme-toggle class="btn !px-2.5 !py-1.5" aria-label={t('theme.toggle', lang)}>
      <Sun class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>
</header>
