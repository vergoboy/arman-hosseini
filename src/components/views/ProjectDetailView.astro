---
import { ArrowLeft } from '@lucide/astro';
import type { Project } from '../../data/projects';
import { localizedPath, useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const d = useTranslations(lang);
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
  <a
    href={localizedPath(lang, 'projects')}
    class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors duration-300 hover:text-accent"
  >
    <ArrowLeft class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
    <span dir="ltr">{d.projects.back}</span>
  </a>

  <p class="mt-10 font-mono text-sm text-accent">{project.tagline}</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{project.name}</h1>

  <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
    {
      project.tags.map((tag) => (
        <li dir="auto" class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">
          {tag}
        </li>
      ))
    }
  </ul>

  <!--
    Vault-backed projects pass their rendered note body in as the default slot. The built-in
    fallback copy renders its own paragraph list. `.mdx-body` (src/styles/global.css) styles
    the Markdown output to match the site theme.
  -->
  <div class="mdx-body mt-10">
    <slot>
      {project.body.map((paragraph) => <p>{paragraph}</p>)}
    </slot>
  </div>

  <h2 class="mt-12 text-xl font-semibold text-primary">{d.projects.whatItDoes}</h2>

  <ul class="mt-4 space-y-2 text-muted">
    {
      project.highlights.map((highlight) => (
        <li class="flex gap-3">
          <span class="inline-block font-mono text-accent rtl:-scale-x-100" aria-hidden="true">
            &gt;
          </span>
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>

  {
    project.links && project.links.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-3">
        {project.links.map((link) => (
          <a
            href={link.href}
            rel="noopener"
            target="_blank"
            class="rounded-md border border-line px-4 py-2 text-sm font-medium text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
          >
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</main>
