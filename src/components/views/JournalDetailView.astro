---
import { ArrowLeft } from '@lucide/astro';
import { formatEntryDate, type JournalEntry } from '../../data/journal';
import { localizedPath, useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
  entry: JournalEntry;
}

const { lang, entry } = Astro.props;
const d = useTranslations(lang);
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
  <a
    href={localizedPath(lang, 'journal')}
    class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors duration-300 hover:text-accent"
  >
    <ArrowLeft class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
    <span dir="ltr">{d.journal.back}</span>
  </a>

  <p class="mt-10 font-mono text-sm text-accent">
    <time datetime={formatEntryDate(entry.date)} dir="ltr">{formatEntryDate(entry.date)}</time>
  </p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{entry.title}</h1>

  {
    entry.tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2" aria-label={entry.title}>
        {entry.tags.map((tag) => (
          <li dir="auto" class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  <!-- Rendered vault note. Styled by `.mdx-body` in src/styles/global.css. -->
  <div class="mdx-body mt-10">
    <slot />
  </div>
</main>
