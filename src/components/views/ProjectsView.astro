---
import ProjectCard from '../ProjectCard.astro';
import { getProjectsResolved } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
// Vault-backed when src/content/projects has entries for this language, built-in copy otherwise.
const projects = await getProjectsResolved(lang);
---

<main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-muted">
    <span dir="ltr"><span class="text-accent">$</span> {d.projects.command}</span>
  </p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{d.projects.title}</h1>
  <p class="mt-4 max-w-2xl leading-relaxed text-muted">{d.projects.intro}</p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      projects.map((project) => (
        <ProjectCard project={project} lang={lang} showBadge />
      ))
    }
  </div>
</main>
