---
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
const lastIndex = d.about.timeline.length - 1;
---

<main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-muted">
    <span dir="ltr"><span class="text-accent">$</span> {d.about.command}</span>
  </p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{d.about.title}</h1>
  <p class="mt-4 max-w-2xl leading-relaxed text-muted">{d.about.intro}</p>

  <section class="mt-14" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading" class="text-xl font-semibold">{d.about.timelineTitle}</h2>

    <div class="mt-6 overflow-hidden rounded-xl border border-line bg-surface">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3" dir="ltr">
        <span class="h-2.5 w-2.5 rounded-full bg-muted/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-muted/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-muted/40"></span>
        <span class="ms-2 font-mono text-xs text-muted">~/history.log</span>
      </div>

      <ol class="p-6">
        {
          d.about.timeline.map((entry, index) => (
            <li
              class:list={['relative border-s border-line ps-6', index === lastIndex ? '' : 'pb-8']}
            >
              <span
                class="absolute -start-[5px] top-1.5 h-2.5 w-2.5 rounded-full border border-accent bg-page"
                aria-hidden="true"
              />
              <p class="font-mono text-xs uppercase tracking-wider text-accent">{entry.period}</p>
              <h3 class="mt-2 text-lg font-semibold text-primary">{entry.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{entry.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mt-16" aria-labelledby="stack-heading">
    <h2 id="stack-heading" class="text-xl font-semibold">{d.about.stackTitle}</h2>

    <div class="mt-6 grid gap-x-8 gap-y-8 sm:grid-cols-2">
      {
        d.about.stack.map((group) => (
          <div>
            <h3 class="font-mono text-xs uppercase tracking-wider text-muted">{group.group}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li
                  dir="auto"
                  class="rounded border border-line bg-surface px-2.5 py-1 font-mono text-xs text-primary"
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16" aria-labelledby="currently-heading">
    <h2 id="currently-heading" class="text-xl font-semibold">{d.about.currentlyTitle}</h2>

    <ul class="mt-4 space-y-2 text-muted">
      {
        d.about.currently.map((item) => (
          <li class="flex gap-3">
            <span
              class="inline-block font-mono text-accent rtl:-scale-x-100"
              aria-hidden="true"
            >
              &gt;
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>
</main>
