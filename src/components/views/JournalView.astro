---
import { getJournal, formatEntryDate } from '../../data/journal';
import { localizedPath, useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
const entries = await getJournal(lang);
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-muted">
    <span dir="ltr"><span class="text-accent">$</span> {d.journal.command}</span>
  </p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{d.journal.title}</h1>
  <p class="mt-4 max-w-2xl leading-relaxed text-muted">{d.journal.intro}</p>

  {
    entries.length === 0 ? (
      <div class="mt-10 rounded-xl border border-line bg-surface p-6">
        <p class="leading-relaxed text-muted">{d.journal.empty}</p>
        <p class="mt-3 font-mono text-xs text-muted">
          <span dir="ltr"><span class="text-accent">$</span> {d.journal.emptyHint}</span>
        </p>
      </div>
    ) : (
      <ul class="mt-10 space-y-4">
        {entries.map((entry) => (
          <li>
            <a
              href={localizedPath(lang, `journal/${entry.slug}`)}
              class="group block rounded-xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-accent hover:bg-zinc-500/5"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h2 class="text-lg font-semibold text-primary transition-colors duration-300 group-hover:text-accent">
                  {entry.title}
                </h2>
                <time
                  datetime={formatEntryDate(entry.date)}
                  class="font-mono text-xs text-muted"
                  dir="ltr"
                >
                  {formatEntryDate(entry.date)}
                </time>
              </div>

              {entry.summary && (
                <p class="mt-3 text-sm leading-relaxed text-muted">{entry.summary}</p>
              )}

              {
                entry.tags.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label={entry.title}>
                    {entry.tags.map((tag) => (
                      <li dir="auto" class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )
              }
            </a>
          </li>
        ))}
      </ul>
    )
  }
</main>
