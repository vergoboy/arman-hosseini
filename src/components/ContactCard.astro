---
import { ArrowUpRight } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import type { ContactMethod } from '../i18n/translations';

interface Props {
  method: ContactMethod;
}

const { method } = Astro.props;
const isExternal = method.href ? !method.href.startsWith('mailto:') : false;

const shell =
  'group flex h-full flex-col gap-4 rounded-xl border border-line bg-surface p-5 transition-colors duration-300 hover:border-accent';
---

{
  method.href ? (
    <a
      href={method.href}
      rel="me noopener"
      target={isExternal ? '_blank' : undefined}
      class={shell}
    >
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line text-accent">
            <BrandIcon name={method.icon} class="h-4 w-4" />
          </span>
          <span class="text-sm font-medium text-primary">{method.label}</span>
        </div>
        <ArrowUpRight
          class="h-4 w-4 shrink-0 text-muted transition-colors duration-300 group-hover:text-accent rtl:-scale-x-100"
          aria-hidden="true"
        />
      </div>

      <p class="font-mono text-xs text-accent">
        <span dir="ltr">{method.command}</span>
      </p>

      <div class="mt-auto flex flex-col gap-1">
        <span dir="ltr" class="font-mono text-sm text-primary">
          {method.handle}
        </span>
        <span class="text-xs text-muted">{method.note}</span>
      </div>
    </a>
  ) : (
    <div class={shell}>
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line text-accent">
            <BrandIcon name={method.icon} class="h-4 w-4" />
          </span>
          <span class="text-sm font-medium text-primary">{method.label}</span>
        </div>
      </div>

      <p class="font-mono text-xs text-accent">
        <span dir="ltr">{method.command}</span>
      </p>

      <div class="mt-auto flex flex-col gap-1">
        <span dir="ltr" class="font-mono text-sm text-primary">
          {method.handle}
        </span>
        <span class="text-xs text-muted">{method.note}</span>
      </div>
    </div>
  )
}
