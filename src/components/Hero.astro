---
import { ArrowUpRight } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { site } from '../data/site';
import { localizedPath, useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
const name = lang === 'fa' ? site.alternateName : site.name;
---

<header class="py-20 sm:py-28">
  <p class="font-mono text-sm text-muted">
    <span dir="ltr"><span class="text-accent">$</span> {d.hero.prompt}</span>
  </p>

  <h1 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl">
    {name}<span class="animate-blink text-accent" aria-hidden="true">_</span>
  </h1>

  <p class="mt-4 max-w-2xl text-lg text-muted sm:text-xl">{d.hero.role}</p>
  <p class="mt-4 max-w-xl text-muted">{d.hero.bio}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={localizedPath(lang, 'projects')}
      class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-zinc-950 transition-colors duration-300 hover:bg-orange-500"
    >
      {d.hero.ctaProjects}
      <ArrowUpRight class="h-4 w-4 rtl:-scale-x-100" aria-hidden="true" />
    </a>
    <a
      href="https://github.com/vergoboy"
      rel="me noopener"
      target="_blank"
      class="inline-flex items-center gap-2 rounded-md border border-line px-4 py-2 text-sm font-medium text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
    >
      <BrandIcon name="github" class="h-4 w-4" />
      {d.hero.ctaGitHub}
    </a>
  </div>

  <ul
    aria-label={d.hero.stackLabel}
    class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted"
  >
    {
      d.hero.stack.map((item) => (
        <li>
          <span class="text-accent">#</span>
          <span dir="auto">{item}</span>
        </li>
      ))
    }
  </ul>
</header>
