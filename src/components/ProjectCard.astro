---
import { ArrowUpRight } from '@lucide/astro';
import type { Project } from '../data/projects';
import { localizedPath, t, type Lang } from '../i18n/translations';

interface Props {
  project: Project;
  lang: Lang;
  class?: string;
  showBadge?: boolean;
}

const { project, lang, class: className = '', showBadge = false } = Astro.props;
const featured = showBadge && project.featured;
---

<a
  href={localizedPath(lang, `projects/${project.slug}`)}
  class:list={[
    'group relative flex flex-col justify-between rounded-xl border border-line bg-surface p-6',
    'transition-colors duration-300 hover:border-accent hover:bg-zinc-500/5',
    className,
  ]}
>
  {
    featured && (
      <span class="absolute end-3 top-3 rounded-full bg-accent px-2.5 py-1 font-mono text-[11px] font-semibold uppercase leading-none tracking-wider text-zinc-950">
        {t('projects.featured', lang)}
      </span>
    )
  }

  <div>
    <div class:list={[featured && 'pe-24']}>
      <h3
        class="text-lg font-semibold text-primary transition-colors duration-300 group-hover:text-accent"
      >
        {project.name}
      </h3>
      <p class="mt-1 font-mono text-xs text-muted">{project.tagline}</p>
    </div>

    <p class="mt-4 text-sm leading-relaxed text-muted">{project.summary}</p>
  </div>

  <div class="mt-6 flex items-end justify-between gap-4">
    <ul class="flex flex-wrap gap-2" aria-label={`${project.name} technologies`}>
      {
        project.tags.map((tag) => (
          <li
            dir="auto"
            class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-muted transition-colors duration-300 group-hover:border-accent/40"
          >
            {tag}
          </li>
        ))
      }
    </ul>

    <ArrowUpRight
      class="h-5 w-5 shrink-0 text-muted transition-colors duration-300 group-hover:text-accent rtl:-scale-x-100"
      aria-hidden="true"
    />
  </div>
</a>
