---
interface Props { cmd: string; title: string; id?: string; href?: string; more?: string }
const { cmd, title, id, href, more } = Astro.props;
---
<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    <p class="eyebrow" dir="ltr">$ {cmd}</p>
    <h2 id={id} class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  </div>
  {href && more && <a href={href} class="text-sm text-accent hover:underline">{more} →</a>}
</div>
