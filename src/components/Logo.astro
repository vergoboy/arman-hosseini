---
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
---

<a href={`/${lang}/`} class:list={['group inline-flex items-center gap-3', className]}>
  <picture>
    <source srcset="/assets/Vargo/Export.svg" type="image/svg+xml" />
    <img
      src="/assets/Vargo/Export.png"
      alt=""
      width="32"
      height="32"
      decoding="async"
      class="h-8 w-8 shrink-0"
    />
  </picture>
  <span class="flex flex-col leading-tight">
    <span
      class="font-mono text-sm font-medium text-primary transition-colors duration-300 group-hover:text-accent"
    >
      vargo
    </span>
    <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-muted">
      Arman Hosseini
    </span>
  </span>
</a>
