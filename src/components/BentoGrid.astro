---
import { ArrowRight } from '@lucide/astro';
import ProjectCard from './ProjectCard.astro';
import { getFeaturedProjectsResolved } from '../data/projects';
import { localizedPath, useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang);
const featured = await getFeaturedProjectsResolved(lang);

const spanClasses: Record<string, string> = {
  both: 'md:col-span-2 md:row-span-2',
  col: 'md:col-span-2',
  row: 'md:row-span-2',
  full: 'md:col-span-3',
  none: '',
};
---

<section id="projects" aria-labelledby="projects-heading" class="pb-24">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
    <!-- The visible heading is a shell command, so give it a human-readable name. -->
    <h2 id="projects-heading" aria-label={d.home.featured} class="text-2xl font-semibold">
      <span dir="ltr"><span class="text-accent">$</span> {d.home.featuredCommand}</span>
    </h2>
    <a
      href={localizedPath(lang, 'projects')}
      class="font-mono text-sm text-muted transition-colors duration-300 hover:text-accent"
    >
      {d.home.viewAll}
      <ArrowRight class="ms-1 -mb-0.5 inline h-3.5 w-3.5 rtl:-scale-x-100" aria-hidden="true" />
    </a>
  </div>

  <div class="mt-8 grid gap-4 md:auto-rows-fr md:grid-cols-3">
    {
      featured.map((project) => (
        <ProjectCard project={project} lang={lang} class={spanClasses[project.span]} />
      ))
    }
  </div>
</section>
