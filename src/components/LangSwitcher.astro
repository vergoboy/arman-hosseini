---
import { languages, switchLangPath, t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
---

<nav
  aria-label={t('lang.label', lang)}
  class="inline-flex items-center gap-0.5 rounded-md border border-line p-0.5"
>
  {
    languages.map((code) => {
      const active = code === lang;
      return (
        <a
          href={switchLangPath(path, code)}
          hreflang={code}
          aria-current={active ? 'true' : undefined}
          class:list={[
            'rounded px-2 py-1 font-mono text-xs transition-colors duration-300',
            active ? 'bg-accent text-zinc-950' : 'text-muted hover:text-accent',
          ]}
        >
          {t(`lang.${code}`, lang)}
        </a>
      );
    })
  }
</nav>
