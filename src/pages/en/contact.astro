---
import Layout from '../../layouts/Layout.astro';
import ContactView from '../../components/views/ContactView.astro';
import { site } from '../../data/site';
import { localizedPath, useTranslations, type Lang } from '../../i18n/translations';

const lang: Lang = 'en';
const d = useTranslations(lang);

const jsonLd = [
  {
    '@type': 'ContactPage',
    url: `${site.url}${localizedPath(lang, 'contact')}`,
    name: d.meta.contact.title,
    description: d.meta.contact.description,
    inLanguage: lang,
    mainEntity: {
      '@id': `${site.url}/#person`,
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'Email',
          email: site.email,
          url: `${site.url}${localizedPath(lang, 'contact')}`,
          availableLanguage: ['English', 'Persian'],
        },
      ],
    },
  },
];
---

<Layout
  lang={lang}
  title={d.meta.contact.title}
  description={d.meta.contact.description}
  jsonLd={jsonLd}
>
  <ContactView lang={lang} />
</Layout>
