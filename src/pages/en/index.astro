---
import Layout from '../../layouts/Layout.astro';
import HomeView from '../../components/views/HomeView.astro';
import { site } from '../../data/site';
import { localizedPath, useTranslations, type Lang } from '../../i18n/translations';

const lang: Lang = 'en';
const d = useTranslations(lang);
const homeUrl = `${site.url}${localizedPath(lang, '')}`;

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: ['en', 'fa'],
  },
  {
    '@type': 'ProfilePage',
    url: homeUrl,
    name: d.meta.home.title,
    description: d.meta.home.description,
    inLanguage: lang,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#person` },
  },
];
---

<Layout
  lang={lang}
  title={d.meta.home.title}
  description={d.meta.home.description}
  jsonLd={jsonLd}
>
  <HomeView lang={lang} />
</Layout>
