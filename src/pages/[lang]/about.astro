---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Quick from '../../components/Quick.astro';
import { breadcrumbs, staticSeo } from '../../lib/seo';
import { languages, lp, type Lang } from '../../lib/i18n';
import { useTranslations } from '../../i18n/translations';
import { U } from '../../lib/ui';
import { site } from '../../data/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const d = useTranslations(lang); const u = U(lang);
const a = d.about;
const s = staticSeo(lang, 'about', d.meta.about);
const crumbs = [{ name: d.nav.home, url: lp(lang) }, { name: a.title, url: lp(lang, 'about') }];
---
<Base navKey="about" seo={{ lang, path: lp(lang, 'about'), ...s, type: 'profile', alternates: { en: lp('en', 'about'), fa: lp('fa', 'about') },
  graph: [breadcrumbs(crumbs), { '@type': 'ProfilePage', url: site.url + lp(lang, 'about'), name: s.title, inLanguage: lang, mainEntity: { '@id': `${site.url}/#person` } }] }}>
  <main id="main" class="wrap flex-1 py-10 sm:py-14">
    <Crumbs items={crumbs} />
    <p class="eyebrow mt-8" dir="ltr">$ {a.command}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{a.title}</h1>
    <div class="mt-6 max-w-3xl"><Quick lang={lang} label={u.whoLabel} text={u.who} /></div>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">{a.intro}</p>

    {a.sections.map((sec, i) => (
      <section class="mt-12 max-w-3xl" aria-labelledby={`s${i}`}>
        <h2 id={`s${i}`} class="text-2xl font-semibold">{sec.title}</h2>
        {sec.body.map((p) => <p class="mt-4 leading-8 text-muted">{p}</p>)}
      </section>
    ))}

    <section class="mt-14" aria-labelledby="ex"><h2 id="ex" class="text-2xl font-semibold">{a.exploreTitle}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {a.explore.map((x) => (
          <li class="card"><a class="text-lg font-semibold text-primary hover:text-accent" href={lp(lang, x.href)}>{x.label}</a><p class="mt-2 leading-7 text-muted">{x.body}</p></li>
        ))}
      </ul></section>

    <section class="mt-14" aria-labelledby="cu"><h2 id="cu" class="text-2xl font-semibold">{a.currentlyTitle}</h2>
      <ul class="mt-4 space-y-2">{a.currently.map((c) => <li class="flex gap-3"><span class="mono text-accent" aria-hidden="true">›</span><span class="text-muted">{c}</span></li>)}</ul></section>
  </main>
</Base>
