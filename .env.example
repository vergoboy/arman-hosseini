# Copy to `.env` (git-ignored) and fill in.
#
# `deploy.config.json` is committed and must never hold a secret — scripts/deploy.sh
# refuses to run if it finds password/passphrase/key fields there. Everything secret
# lives here instead.

# Preferred: leave this unset and use the SSH key named by `identityFile` in
# deploy.config.json, with the key loaded into ssh-agent if it has a passphrase.
#
# Set this only if the server does not accept key auth. Requires `sshpass` on PATH.
# DEPLOY_SSH_PASSWORD=

# Point at a different vault when running `npm run sync:content` (defaults to the
# path baked into scripts/sync-content.mjs).
# OBSIDIAN_VAULT=/home/arman/Documents/obsidian/arman/arman-hosseini

# Use a different config file.
# DEPLOY_CONFIG=./deploy.config.json
